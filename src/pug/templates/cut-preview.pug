script#cut-preview-template(type="text/x-template")
  .cut-preview(v-show="active")
    .cut-preview-settings.pure-form
      label Tool Ø
        input(type="number", min="0.1", step="0.05", v-model="toolDia", number,
          @change="restart", title="Cutter diameter in mm.")
        | mm

      select(v-model="toolType", @change="restart")
        option(value="flat") Flat end mill
        option(value="v") V-bit

      label(v-if="toolType == 'v'") Angle
        input(type="number", min="10", max="170", step="1", v-model="vAngle", number,
          @change="restart", title="Included angle of the V-bit in degrees.")
        | °

      label Stock top Z
        input(type="number", step="0.1", v-model="stockTop", number,
          @change="restart", title="Z height of the top of the stock in the work coordinates.")
        | mm

    .cut-preview-error(v-if="error") {{error}}

    .cut-preview-stage
      canvas.depth
      canvas.marker
      .cut-preview-busy(v-if="busy") Simulating {{percent}}%

    .cut-preview-transport
      button.pure-button(@click="toggle_play", :disabled="busy || !last")
        | {{playing ? 'Pause' : 'Play'}}
      input(type="range", min="0", :max="last", step="1", :value="position",
        @input="scrub($event)", :disabled="busy || !last")

    .cut-preview-readout {{readout}}

    .cut-preview-warn(v-if="rapidHits")
      | {{rapidHits}} rapid move{{rapidHits == 1 ? '' : 's'}} would run below the stock surface.

    .cut-preview-legend
      .bar
      .ticks
        span 0 mm
        span {{depthLabel}}
